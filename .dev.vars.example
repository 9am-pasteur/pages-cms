BASE_URL = "http://localhost:8788"

# Optional basic auth for Pages Functions preview
# BASIC_AUTH = "false"
# BASIC_USERNAME = "admin"
# BASIC_PASSWORD = "change-me"

# GitHub OAuth App (not GitHub App) credentials
GITHUB_CLIENT_ID = "XXX"
GITHUB_CLIENT_SECRET = "XXX"
# GitLab OAuth App (PKCE, secret optional)
GITLAB_CLIENT_ID = "XXX"
# If you use self-hosted GitLab, set these; otherwise omit.
# GITLAB_BASE = "https://gitlab.example.com"
# GITLAB_API_BASE = "https://gitlab.example.com/api/v4"

# CKEditor4 / Cloudinary (optional)
# Provide either:
#  - CLOUDINARY_DIALOG_URL: reverse-proxy an existing dialog (must be same origin after proxy)
#  - or Cloudinary Media Library Widget credentials to use the built-in MLW:
#      CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#      CLOUDINARY_USERNAME (optional, used for MLW sign-in convenience)
# If none are set, Cloudinary button will still render but MLW/remote dialog will be unavailable.
# CLOUDINARY_DIALOG_URL = "https://onprem.example.com/scripts/cloudinary_dialog.pl"
# CLOUDINARY_CLOUD_NAME = "your-cloud-name"
# CLOUDINARY_API_KEY = "your-api-key"
# CLOUDINARY_API_SECRET = "your-api-secret"
# CLOUDINARY_USERNAME = "user@example.com"

# Cloudflare Access JWT verification (required when using proxy_github_app mode)
# CLOUDFLARE_ACCESS_TEAM_DOMAIN = "your-team.cloudflareaccess.com"
# CLOUDFLARE_ACCESS_AUD = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Optional explicit issuer override. Normally inferred from team domain.
# CLOUDFLARE_ACCESS_ISSUER = "https://your-team.cloudflareaccess.com"

# Authorization lists used by /api/bootstrap and proxy mode
# Comma-separated emails (normalized to lowercase)
# CMS_ADMIN_USERS = "alice@example.ac.jp,bob@example.ac.jp"
# CMS_DENY_USERS = "suspended@example.ac.jp"

# proxy_github_app path policy (comma-separated glob-like patterns)
# Allowed paths should be narrow and content-only
# CMS_PROXY_ALLOWED_PATHS = "content/articles/**,content/assets/**"
# CMS_PROXY_DENIED_PATHS = ".cms/**,.github/**,scripts/**,config/**,package.json"

# Fixed repository target for proxy_github_app
# GITHUB_REPO_OWNER = "example-org"
# GITHUB_REPO_NAME = "content-repo"
# GITHUB_BRANCH = "main"

# GitHub App (used by proxy_github_app backend)
# IMPORTANT: this is the GitHub App private key PEM (multiline secret)
# GITHUB_APP_ID = "123456"
# GITHUB_APP_INSTALLATION_ID = "78901234"
# GITHUB_APP_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
